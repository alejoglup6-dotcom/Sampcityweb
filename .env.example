# Copia este archivo a .env y rellena los valores. NUNCA subas el .env real a Git.
BASE_URL=https://tudominio.com
PORT=3000
# Larga y aleatoria (mínimo 24 caracteres). Rotarla cierra todas las sesiones.
SESSION_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Base de datos del servidor de juego
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_POOL=
MYSQL_SSL=
MYSQL_SSL_STRICT=

# Jugadores y permisos
SERVER_IP=
SKIN_URL=
SKIN_COLUMN=skin
POST_MIN_LEVEL=5
VACANCY_MIN_LEVEL=

# Medios (fotos, videos, reels)
VIDEO_MAX_MB=25
REEL_MAX_MB=60
REEL_MAX_SECS=90
REEL_MAX_KBPS=
REEL_TRANSCODE=
MEDIA_CACHE_MB=
FFMPEG_PATH=
NOTIF_BROADCAST_MAX=

# Carpeta del servidor donde se guardan fotos y videos (recomendado; vacío = en la base de datos).
# Debe quedar fuera de public/ y no borrarse al actualizar la web. Para pasar los que ya existen: node scripts/medios-a-disco.js
MEDIA_DIR=

# Correo (recuperar contraseña). Vacío = desactivado.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Notificaciones push (opcional: si están vacías, la web genera las claves y las guarda en la base de datos)
VAPID_PUBLIC=
VAPID_PRIVATE=

# Discord (vincular cuenta)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_MODO=

# Cloudflare Turnstile (anti-bots, opcional)
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=

# Tebex (tienda)
TEBEX_PUBLIC_TOKEN=
TEBEX_PRIVATE_KEY=
TEBEX_WEBHOOK_SECRET=

# Launcher de Android
LAUNCHER_SERVER=
LAUNCHER_CDN=
LAUNCHER_VERSION=
LAUNCHER_APK_URL=
LAUNCHER_GAME_VERSION=
LAUNCHER_GAME_APK_URL=
